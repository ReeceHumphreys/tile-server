# Copy to .env (gitignored) and fill in. All values are optional unless noted.
TILE_ROOT=./published
PORT=8787
BIND_ADDRESS=127.0.0.1
CORS_ORIGIN=*

# S3 emulator profile (docker compose --profile s3)
TILE_BUCKET=planet-tiles
TILE_RELEASE=local-v1
S3_PORT=4566

# Required only for compose.localstack.yaml
LOCALSTACK_AUTH_TOKEN=
